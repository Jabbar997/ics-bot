# ICS environment variables — copy to .env and fill in.
# NEVER commit your real .env file.

# Telegram bot token from @BotFather (leave blank to run without Telegram)
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram numeric user IDs allowed to use the bot.
# Example: TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
TELEGRAM_ALLOWED_USER_IDS=

# SQLAlchemy database URL. SQLite for MVP; swap for postgresql+psycopg://... later.
DATABASE_URL=sqlite:///./ics.db
